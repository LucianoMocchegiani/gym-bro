# Copiar a web/.env (no se commitea).
# Compose carga este archivo en runtime; NEXT_PUBLIC_* se bakean en `docker compose build`.
# En VPS: esas vars en un `.env` junto a docker-compose.yml (o export) antes del build.

NODE_ENV=development

# El navegador llama a la API publicada en el host:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Tunnel Cloudflare (descomentar al probar por dominio):
# NEXT_PUBLIC_API_URL=https://api-gymbro.pruebasaproduccunon.uno

# Dominio base de tenants (vacío = modo local *.localhost)
# NEXT_PUBLIC_APP_DOMAIN=pruebasaproduccunon.uno
# La plataforma es el tenant `admin` (vive en {slug}.{APP_DOMAIN}); no hay apex aparte.

# Puerto PÚBLICO del web. El compose mapea 3002:3000, así que 3002, no 3000.
NEXT_PUBLIC_WEB_PORT=3002

# Google Sign-In (cliente Web tipo Web de Google Cloud Console)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL canónica de la landing (sitemap, OG, JSON-LD). Puerto publicado del web: 3002.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# NEXT_PUBLIC_SITE_URL=https://faciliter.xyz

# chat-api (C5 drawer). El navegador llama al host, no al hostname Docker.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:3010
