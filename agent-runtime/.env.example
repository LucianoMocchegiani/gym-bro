# Copiar a agent-runtime/.env. No commitear secretos.
# Generar RUNTIME_CONFIG_ENCRYPTION_KEY con: openssl rand -hex 32
# Generar una contraseña DB alfanumérica con: openssl rand -hex 32
# La clave de cifrado persiste config/secrets; respaldarla y no cambiarla.

RUNTIME_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
RUNTIME_ADMIN_USERNAME=runtime-admin
RUNTIME_ADMIN_PASSWORD=replace-with-a-long-unique-password
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://agent:replace-with-a-long-database-password@agent-runtime-postgres:5432/runtime?schema=public
CORS_ORIGIN=http://localhost:3002
