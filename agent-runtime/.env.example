# Copiar a agent-runtime/.env. No commitear secretos.
# Generar RUNTIME_CONFIG_ENCRYPTION_KEY con: openssl rand -hex 32
# La clave cifra configuración persistida: respaldarla y no cambiarla.

RUNTIME_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
RUNTIME_ADMIN_USERNAME=runtime-admin
RUNTIME_ADMIN_PASSWORD=replace-with-a-long-unique-password
AGENT_RUNTIME_DB_PASSWORD=replace-with-a-long-unique-database-password
AGENT_RUNTIME_VERSION=latest
CORS_ORIGIN=http://localhost:3002
UI_ENABLED=true
