# Copiar a chat-api/.env (no se commitea).
# Compose carga este archivo en el servicio `chat-api`.
# Cero GYMBRO_*: otra plataforma = otras URLs, misma imagen.

NODE_ENV=development
PORT=3010

# Hostname `postgres` = servicio Compose (red interna). Database propia `chat`.
DATABASE_URL=postgresql://gymbro:gymbro@postgres:5432/chat?schema=public

# Sidecar MCP de esta instancia (C3). C1 no lo llama; hace falta para arrancar.
CHAT_MCP_URL=http://mcp:3011/mcp

# Introspección del huésped (C2). GymBro: GET /api/auth/me.
AUTH_INTROSPECT_URL=http://api:3001/api/auth/me
AUTH_REQUIRED_PROFILE=STAFF

# OpenRouter (C4). Placeholder hasta tener clave real.
# Compose: `restart` no recarga env_file. Tras editar, recreá:
#   docker compose up -d --force-recreate chat-api
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Orígenes del panel que embebe el chat (coma-separados).
CORS_ORIGIN=http://localhost:3002,http://demo.localhost:3002
# Tunnel: https://{slug}.dominio y el apex (igual que Nest).
# CORS_APP_DOMAIN=faciliter.xyz

CHAT_SYSTEM_PROMPT=Hablá en español. Usá las tools. No inventes ids.

# C4: ventana de prompt (aprox. chars/4) y tope de pasos con tools.
# CHAT_CONTEXT_TOKENS=10000
# CHAT_MAX_TOOL_STEPS=8

# Si corrés chat-api en el host contra Postgres en Docker:
# DATABASE_URL=postgresql://gymbro:gymbro@localhost:5433/chat?schema=public
# AUTH_INTROSPECT_URL=http://localhost:3001/api/auth/me
