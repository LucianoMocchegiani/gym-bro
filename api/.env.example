# Copiar a api/.env (no se commitea).
# Docker Compose carga este archivo en el servicio `api`.

NODE_ENV=development
PORT=3001

# Hostname `postgres` = servicio del docker-compose (red interna).
DATABASE_URL=postgresql://gymbro:gymbro@postgres:5432/gymbro?schema=public
REDIS_URL=redis://redis:6379

# JWT (cambiar en cualquier entorno no local)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Mercado Pago — cifrado de access_token en DB (min 16 chars)
MP_CREDENTIALS_SECRET=dev-mp-credentials-secret-change-me
# live = GET https://api.mercadopago.com/users/me | stub = acepta cualquier token (solo local)
MP_ACCOUNT_VALIDATE_MODE=stub

# Si corrés Nest / Prisma CLI en el host contra Postgres en Docker, usá:
# DATABASE_URL=postgresql://gymbro:gymbro@localhost:5432/gymbro?schema=public
# REDIS_URL=redis://localhost:6379

# Migraciones (manuales en dev):
#   npm run prisma:migrate
# Seed demo (super / staff / member):
#   npm run prisma:seed
# En contenedor:
#   docker compose exec api npm run prisma:migrate
#   docker compose exec api npm run prisma:seed
