# Copiar a api/.env (no se commitea).
# Docker Compose carga este archivo en el servicio `api`.

NODE_ENV=development
PORT=3001
# Orígenes del panel web (coma-separados). Compose publica el web en host :3002.
CORS_ORIGIN=http://localhost:3002,http://demo.localhost:3002
# Tunnel: permite https://{slug}.dominio y el apex del dominio
# CORS_APP_DOMAIN=pruebasaproduccunon.uno

# Hostname `postgres` = servicio del docker-compose (red interna).
DATABASE_URL=postgresql://gymbro:gymbro@postgres:5432/gymbro?schema=public
REDIS_URL=redis://redis:6379

# JWT (cambiar en cualquier entorno no local)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Mercado Pago — cifrado de access_token en DB (min 16 chars)
MP_CREDENTIALS_SECRET=dev-mp-credentials-secret-change-me
# Base pública para notification_url de Preferences (túnel ngrok en live)
PUBLIC_API_BASE_URL=http://localhost:3001

# Acceso puerta: OID4VP vía Kuatia (issuer/verifier compartidos del producto GymBro).
# Docs: https://kuatia.xyz/docs — Auth: header x-api-key (iss_live_… / ver_live_…).
# No se levantan quark-issuer/quark-verifier en Compose.

KUATIA_ISSUER_BASE_URL=https://issuer.kuatia.xyz
KUATIA_VERIFIER_BASE_URL=https://verifier.kuatia.xyz
KUATIA_ISSUER_API_KEY=iss_live_replace_me
KUATIA_VERIFIER_API_KEY=ver_live_replace_me
# walletId del producto compartido (consola Kuatia); todos los gyms usan estos IDs
KUATIA_ISSUER_WALLET_ID=replace_with_issuer_wallet_id
KUATIA_VERIFIER_WALLET_ID=replace_with_verifier_wallet_id
KUATIA_HTTP_TIMEOUT_MS=20000

# Si corrés Nest / Prisma CLI en el host contra Postgres en Docker, usá:
# DATABASE_URL=postgresql://gymbro:gymbro@localhost:5433/gymbro?schema=public
# REDIS_URL=redis://localhost:6379

# Migraciones (manuales en dev):
#   npm run prisma:migrate
# Seed demo (super / staff / member):
#   npm run prisma:seed
# En contenedor:
#   docker compose exec api npm run prisma:migrate
#   docker compose exec api npm run prisma:seed

# Cloudflare R2 — almacenamiento de imágenes (S3-compatible)
# Crear bucket en dash.cloudflare.com → R2 → Create bucket
# API tokens: dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=tu_bucket_name
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
R2_KEY_PREFIX=gymbro/
