# Copiar a api/.env (no se commitea).
# Docker Compose carga este archivo en el servicio `api`.

NODE_ENV=development
PORT=3001

# Hostname `postgres` = servicio del docker-compose (red interna).
DATABASE_URL=postgresql://gymbro:gymbro@postgres:5432/gymbro
REDIS_URL=redis://redis:6379

# Si corrés Nest en el host contra Postgres/Redis en Docker, usá:
# DATABASE_URL=postgresql://gymbro:gymbro@localhost:5432/gymbro
# REDIS_URL=redis://localhost:6379
