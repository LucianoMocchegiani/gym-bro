// GymBro — schema Prisma (PostgreSQL).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado operativo del gym en la plataforma (RN-TEN-002 / CU-ROL-002).
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Tipo de perfil autenticado. Staff y afiliado nunca comparten sesión (RN-ROL-005).
enum AuthProfileType {
  SUPER
  STAFF
  MEMBER
}

/// Estado operativo del afiliado en el tenant (CU-AFI-003).
enum MemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// Tipo de servicio del catálogo comercial (RN-SER-001).
enum ServiceType {
  ACCESO_LIBRE
  POR_SESIONES
}

/// Periodicidad de cobro del pack (aplicable a libre y a sesiones).
enum BillingPeriod {
  MONTHLY
  ONE_TIME
}

/// Estado de un pago (RN-PAG-003).
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

/// Medio de cobro. STUB = aprobación simulada; CASH = caja; MP = Mercado Pago.
enum PaymentMethod {
  STUB
  CASH
  MP
}

/// Estado de una contratación (dominio Contratacion).
enum ContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

/// Estado de una sesión de calendario (CU-SER-003).
enum SessionStatus {
  PUBLISHED
  CANCELLED
}

/// Día de semana para reglas de recurrencia (ISO-8601).
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Estado de una reserva (CU-RES-001).
enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

/// Medio de cobertura de la reserva.
enum ReservationCoverage {
  CREDIT
  DROP_IN
}

/// Modo de liberación de lista de espera (RN-RES-005 / RN-TEN-006).
enum WaitlistMode {
  AUTO_ASSIGN
  MEMBER_CONFIRM
  STAFF_CONFIRM
}

/// Estado de un ítem en cola de espera (CU-RES-004).
enum WaitlistStatus {
  WAITING
  PROMOTED
  LEFT
}

/// Tipo de movimiento de caja (RN-PAG-007).
enum CashMovementKind {
  INCOME
  OUTCOME
}

/// Concepto de negocio del movimiento de caja.
enum CashMovementConcept {
  PACK_CONTRACT
  DROP_IN
  REFUND
}

/// Estado de solicitud de devolución (CU-PAG-004).
enum RefundRequestStatus {
  PENDING
  REJECTED
  EXECUTED
}

/// Concepto del comprobante interno (RN-PAG-009).
enum ReceiptConcept {
  PACK_CONTRACT
  DROP_IN
}

/// Estado de credencial de vínculo de acceso (RN-ACC-002).
enum AccessCredentialStatus {
  ACTIVE
  REVOKED
}

/// Gimnasio / estudio = tenant SaaS.
///
/// @remarks Aislamiento row-level: el resto de tablas de negocio
/// referenciarán `tenants.id` como `tenant_id` (RN-TEN-001).
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  staffUsers      StaffUser[]
  members         Member[]
  branches        Branch[]
  roles           Role[]
  services        Service[]
  packs           Pack[]
  payments        Payment[]
  contracts       Contract[]
  sessions        Session[]
  recurrenceRules SessionRecurrenceRule[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  settings        TenantSettings?
  cashMovements   CashMovement[]
  cashReconciliations CashReconciliation[]
  receipts        Receipt[]
  receiptSequence ReceiptSequence?
  mercadoPagoAccount MercadoPagoAccount?
  refundRequests  RefundRequest[]
  accessCredentials AccessCredential[]
  auditEvents     AuditEvent[]

  @@map("tenants")
}

/// Cuenta Mercado Pago del gym (CU-PAG-006 / RN-PAG-001).
///
/// @remarks 1:1 con tenant. `access_token` cifrado en reposo; nunca se expone en GET.
model MercadoPagoAccount {
  tenantId              String    @id @map("tenant_id") @db.Uuid
  /// AES-256-GCM del access_token (formato v1:iv:tag:ciphertext).
  accessTokenCiphertext String    @map("access_token_ciphertext")
  publicKey             String    @map("public_key")
  /// `id` de GET /users/me tras validación exitosa.
  mpUserId              String?   @map("mp_user_id")
  lastValidatedAt       DateTime? @map("last_validated_at")
  lastValidationOk      Boolean?  @map("last_validation_ok")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("mercadopago_accounts")
}

/// Configuración operativa del gym (RN-TEN-005 / RN-TEN-006).
///
/// @remarks 1:1 con tenant. Horas de cancelación, modo lista de espera e ingreso tardío.
/// Liberación automática solo implementada para AUTO_ASSIGN (crédito).
model TenantSettings {
  tenantId                     String       @id @map("tenant_id") @db.Uuid
  reservationCancellationHours Int          @default(6) @map("reservation_cancellation_hours")
  waitlistMode                 WaitlistMode @default(AUTO_ASSIGN) @map("waitlist_mode")
  /// RN-RES-006 / CU-RES-006: permitir reservar con crédito tras `startsAt` hasta `endsAt`.
  allowLateSessionEntry        Boolean      @default(false) @map("allow_late_session_entry")
  createdAt                    DateTime     @default(now()) @map("created_at")
  updatedAt                    DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Sucursal / sede física del tenant (S2: modelo multi-sede, MVP 1 visible).
///
/// @remarks RN-TEN-003. Al crear un tenant se inserta una sede default (`isDefault`).
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members         Member[]
  services        Service[]
  sessions        Session[]
  recurrenceRules SessionRecurrenceRule[]

  @@index([tenantId])
  @@map("branches")
}

/// Super Admin de la plataforma GymBro (RN-ROL-001). Sin tenant.
model SuperUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("super_users")
}

/// Usuario staff de un tenant (puede tener N roles en E1).
model StaffUser {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens             RefreshToken[]
  staffRoles                StaffUserRole[]
  instructedSessions        Session[]               @relation("SessionInstructor")
  instructedRecurrenceRules SessionRecurrenceRule[] @relation("RecurrenceInstructor")
  cashMovementsRecorded     CashMovement[]          @relation("CashMovementRecorder")
  cashReconciliations       CashReconciliation[]    @relation("CashReconciliationStaff")
  refundRequestsResolved    RefundRequest[]         @relation("RefundRequestResolver")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("staff_users")
}

/// Afiliado (socio) de un tenant. Perfil separado del staff (RN-ROL-005).
model Member {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  email        String
  passwordHash String       @map("password_hash")
  name         String?
  phone        String?
  document     String?
  branchId     String?      @map("branch_id") @db.Uuid
  status       MemberStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  payments      Payment[]
  contracts     Contract[]
  reservations  Reservation[]
  waitlistEntries WaitlistEntry[]
  cashMovements CashMovement[]
  receipts      Receipt[]
  refundRequests RefundRequest[]
  accessCredentials AccessCredential[]

  @@unique([tenantId, email])
  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([branchId])
  @@map("members")
}

/// Refresh token persistido (hash). Revocable en logout / rotación.
model RefreshToken {
  id          String          @id @default(uuid()) @db.Uuid
  tokenHash   String          @unique @map("token_hash")
  profileType AuthProfileType @map("profile_type")
  superUserId String?         @map("super_user_id") @db.Uuid
  staffUserId String?         @map("staff_user_id") @db.Uuid
  memberId    String?         @map("member_id") @db.Uuid
  expiresAt   DateTime        @map("expires_at")
  revokedAt   DateTime?       @map("revoked_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  superUser SuperUser? @relation(fields: [superUserId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([superUserId])
  @@index([staffUserId])
  @@index([memberId])
  @@map("refresh_tokens")
}

/// Permiso de producto (catálogo global). Los roles por tenant eligen de esta lista.
///
/// @remarks RN-ROL-003: la autorización se evalúa en el tenant del staff;
/// los códigos son fijos de producto (no se inventan por gym).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  dangerous   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Rol de staff dentro de un tenant (RN-ROL-002). Seed: Admin / Profesor.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  staffRoles      StaffUserRole[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Asignación permiso ↔ rol (N:N).
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Asignación staff ↔ rol (multi-rol, RN-ROL-004).
model StaffUserRole {
  staffUserId String @map("staff_user_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffUserId, roleId])
  @@index([roleId])
  @@map("staff_user_roles")
}

/// Servicio del catálogo comercial del tenant (RN-SER-001 / CU-SER-001).
///
/// @remarks `ACCESO_LIBRE` no exige reserva; `POR_SESIONES` se consume con sesiones (E4).
/// `dropInPrice` (ARS) habilita drop-in; null = deshabilitado (RN-SER-006).
model Service {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  type        ServiceType
  name        String
  description String?
  /// Precio drop-in en pesos enteros ARS. Solo aplica a `POR_SESIONES`.
  dropInPrice Int?        @map("drop_in_price")
  active      Boolean     @default(true)
  branchId    String?     @map("branch_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  packComponents  PackComponent[]
  creditBalances  ContractCreditBalance[]
  sessions        Session[]
  recurrenceRules SessionRecurrenceRule[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([branchId])
  @@map("services")
}

/// Pack vendible del catálogo (CU-SER-002 / RN-SER-004..007).
///
/// @remarks El `kind` (ACCESS/CREDITS/MIXED) se infiere de los componentes.
/// `price` en pesos enteros ARS. `creditsExpireAt` null = créditos sin fecha de vencimiento de catálogo.
model Pack {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  name            String
  description     String?
  price           Int
  billingPeriod   BillingPeriod @map("billing_period")
  creditsExpireAt DateTime?     @map("credits_expire_at")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  components PackComponent[]
  payments   Payment[]
  contracts  Contract[]

  @@index([tenantId])
  @@map("packs")
}

/// Componente de un pack: servicio + créditos opcionales (RN-SER-004).
model PackComponent {
  id           String @id @default(uuid()) @db.Uuid
  packId       String @map("pack_id") @db.Uuid
  serviceId    String @map("service_id") @db.Uuid
  creditAmount Int?   @map("credit_amount")

  pack    Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packId, serviceId])
  @@index([serviceId])
  @@map("pack_components")
}

/// Regla semanal que materializa sesiones futuras (CU-SER-004 / RN-SER-012).
model SessionRecurrenceRule {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  serviceId       String    @map("service_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  instructorId    String?   @map("instructor_id") @db.Uuid
  weekdays        Weekday[]
  localStartTime  String    @map("local_start_time")
  durationMinutes Int       @map("duration_minutes")
  timezone        String
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime  @map("ends_on") @db.Date
  capacity        Int
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  instructor StaffUser? @relation("RecurrenceInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  sessions   Session[]

  @@index([tenantId])
  @@index([serviceId])
  @@index([branchId])
  @@index([instructorId])
  @@map("session_recurrence_rules")
}

/// Sesión puntual de un servicio POR_SESIONES (CU-SER-003 / RN-SER-010..013).
///
/// @remarks `instructorId` opcional (StaffUser). `bookedCount` se incrementa al confirmar reserva con crédito.
/// Si fue generada por recurrencia, `recurrenceRuleId` conserva el origen; editarla no cambia la regla.
model Session {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  serviceId        String        @map("service_id") @db.Uuid
  branchId         String        @map("branch_id") @db.Uuid
  instructorId     String?       @map("instructor_id") @db.Uuid
  recurrenceRuleId String?       @map("recurrence_rule_id") @db.Uuid
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime      @map("ends_at")
  capacity         Int
  bookedCount      Int           @default(0) @map("booked_count")
  status           SessionStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service        Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  instructor     StaffUser?             @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  recurrenceRule SessionRecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  reservations   Reservation[]
  waitlistEntries WaitlistEntry[]

  @@unique([recurrenceRuleId, startsAt])
  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@index([serviceId])
  @@index([branchId])
  @@index([instructorId])
  @@index([recurrenceRuleId])
  @@map("sessions")
}

/// Pago de negocio (RN-PAG-003..005).
///
/// @remarks Staff stub/caja → APPROVED inmediato. MP → PENDING hasta webhook.
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  memberId         String        @map("member_id") @db.Uuid
  packId           String?       @map("pack_id") @db.Uuid
  amount           Int
  status           PaymentStatus
  method           PaymentMethod
  idempotencyKey   String        @map("idempotency_key")
  /// Preference Checkout Pro del gym.
  mpPreferenceId   String?       @map("mp_preference_id")
  /// Id del pago en Mercado Pago (dedup webhook).
  mpPaymentId      String?       @unique @map("mp_payment_id")
  mpInitPoint      String?       @map("mp_init_point")
  mpSandboxInitPoint String?     @map("mp_sandbox_init_point")
  /// Timestamp de reembolso total (CU-PAG-005).
  refundedAt       DateTime?     @map("refunded_at")
  refundReason     String?       @map("refund_reason")
  /// MP refund API falló → pendiente manual.
  mpRefundManualPending Boolean  @default(false) @map("mp_refund_manual_pending")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pack     Pack?         @relation(fields: [packId], references: [id], onDelete: SetNull)
  contract Contract?
  reservation Reservation?
  cashMovements CashMovement[]
  receipt Receipt?
  refundRequests RefundRequest[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([memberId])
  @@index([mpPreferenceId])
  @@map("payments")
}

/// Contratación de pack tras pago aprobado (CU-CON-001 / RN-PAG-004).
model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  memberId       String         @map("member_id") @db.Uuid
  packId         String         @map("pack_id") @db.Uuid
  paymentId      String         @unique @map("payment_id") @db.Uuid
  status         ContractStatus @default(ACTIVE)
  startsAt       DateTime       @map("starts_at")
  endsAt         DateTime?      @map("ends_at")
  hasAccessLibre Boolean        @default(false) @map("has_access_libre")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pack         Pack                    @relation(fields: [packId], references: [id], onDelete: Restrict)
  payment      Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  balances     ContractCreditBalance[]
  reservations Reservation[]

  @@index([tenantId])
  @@index([memberId])
  @@index([packId])
  @@map("contracts")
}

/// Saldo de créditos por servicio dentro de una contratación.
model ContractCreditBalance {
  id            String    @id @default(uuid()) @db.Uuid
  contractId    String    @map("contract_id") @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  initialAmount Int       @map("initial_amount")
  remaining     Int
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([contractId, serviceId])
  @@index([serviceId])
  @@map("contract_credit_balances")
}

/// Reserva confirmada de una sesión (CU-RES-001 / RN-RES-001).
///
/// @remarks Cobertura `CREDIT` (contrato + saldo) o `DROP_IN` (pago aprobado).
/// Cancelación con ventana: CU-RES-003. Drop-in no reembolsa el pago en esta entrega.
model Reservation {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  memberId        String              @map("member_id") @db.Uuid
  sessionId       String              @map("session_id") @db.Uuid
  contractId      String?             @map("contract_id") @db.Uuid
  creditBalanceId String?             @map("credit_balance_id") @db.Uuid
  paymentId       String?             @unique @map("payment_id") @db.Uuid
  status          ReservationStatus   @default(CONFIRMED)
  coverage        ReservationCoverage @default(CREDIT)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session       Session                @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  contract      Contract?              @relation(fields: [contractId], references: [id], onDelete: Restrict)
  creditBalance ContractCreditBalance? @relation(fields: [creditBalanceId], references: [id], onDelete: Restrict)
  payment       Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([memberId])
  @@index([sessionId])
  @@index([contractId])
  @@index([creditBalanceId])
  @@map("reservations")
}

/// Ítem de lista de espera de una sesión (CU-RES-004 / RN-RES-004).
///
/// @remarks FIFO por `createdAt`. Unique parcial: un WAITING por (sesión, afiliado).
/// Liberación AUTO_ASSIGN (crédito) en CU-RES-005; otros modos diferidos.
model WaitlistEntry {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  memberId  String         @map("member_id") @db.Uuid
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sessionId, status, createdAt])
  @@index([memberId])
  @@map("waitlist_entries")
}

/// Movimiento de caja del día (CU-PAG-002 / RN-PAG-007 / CU-PAG-005).
///
/// @remarks CASH: ingreso al cobrar; egreso al devolver. Unique `(payment_id, kind)`.
model CashMovement {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  businessDate       DateTime            @map("business_date") @db.Date
  paymentId          String              @map("payment_id") @db.Uuid
  memberId           String              @map("member_id") @db.Uuid
  recordedByStaffId  String?             @map("recorded_by_staff_id") @db.Uuid
  amount             Int
  kind               CashMovementKind    @default(INCOME)
  concept            CashMovementConcept
  createdAt          DateTime            @default(now()) @map("created_at")

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment         Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  member          Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedByStaff StaffUser? @relation("CashMovementRecorder", fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  @@unique([paymentId, kind])
  @@index([tenantId, businessDate])
  @@index([memberId])
  @@map("cash_movements")
}

/// Credencial de vínculo afiliado↔gym para acceso QR/SSI (RN-ACC-001/002).
///
/// @remarks `credentialRef` opaco del adapter. Una sola ACTIVE por member
/// (índice único parcial en migración). Derechos los evalúa GymBro, no la credencial.
model AccessCredential {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  memberId      String                 @map("member_id") @db.Uuid
  credentialRef String                 @unique @map("credential_ref")
  status        AccessCredentialStatus @default(ACTIVE)
  /// Identificador del adapter (`stub` | futuro `quark`).
  provider      String                 @default("stub")
  issuedAt      DateTime               @default(now()) @map("issued_at")
  revokedAt     DateTime?              @map("revoked_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@index([memberId, status])
  @@map("access_credentials")
}

/// Solicitud de devolución del afiliado (CU-PAG-004 / RN-PAG-012).
model RefundRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  paymentId            String              @map("payment_id") @db.Uuid
  memberId             String              @map("member_id") @db.Uuid
  status               RefundRequestStatus @default(PENDING)
  reason               String?
  rejectionReason      String?             @map("rejection_reason")
  resolvedByStaffId    String?             @map("resolved_by_staff_id") @db.Uuid
  resolvedAt           DateTime?           @map("resolved_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment         Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  member          Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resolvedByStaff StaffUser? @relation("RefundRequestResolver", fields: [resolvedByStaffId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([memberId, createdAt])
  @@index([paymentId])
  @@map("refund_requests")
}

/// Contador de comprobantes por tenant (RN-PAG-009).
model ReceiptSequence {
  tenantId   String @id @map("tenant_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("receipt_sequences")
}

/// Comprobante interno de un pago aprobado (RN-PAG-009).
///
/// @remarks 1:1 con Payment APPROVED. Número secuencial por tenant (`GB-000001`).
/// Email N1 diferido (E8). Sin backfill de pagos legacy.
model Receipt {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  paymentId   String           @unique @map("payment_id") @db.Uuid
  memberId    String           @map("member_id") @db.Uuid
  number      Int
  amount      Int
  method      PaymentMethod
  concept     ReceiptConcept
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([memberId, createdAt])
  @@map("receipts")
}

/// Arqueo de caja del día (CU-PAG-003 / RN-PAG-007).
///
/// @remarks Un arqueo por (`tenant_id`, `business_date`). No bloquea cobros
/// posteriores. `difference` = declarado − esperado.
model CashReconciliation {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  businessDate      DateTime @map("business_date") @db.Date
  expectedAmount    Int      @map("expected_amount")
  declaredAmount    Int      @map("declared_amount")
  difference        Int
  reconciledByStaffId String? @map("reconciled_by_staff_id") @db.Uuid
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciledByStaff StaffUser? @relation("CashReconciliationStaff", fields: [reconciledByStaffId], references: [id], onDelete: SetNull)

  @@unique([tenantId, businessDate])
  @@index([tenantId, businessDate])
  @@map("cash_reconciliations")
}

/// Evento de auditoría append-only (RN-ROL-008 / CU-ROL-007).
///
/// @remarks Sin UPDATE/DELETE de negocio. `tenant_id` nulo solo si no aplica
/// (hoy siempre se setea para acciones de gym). Actor SUPER o STAFF.
model AuditEvent {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String?         @map("tenant_id") @db.Uuid
  actorProfile AuthProfileType @map("actor_profile")
  actorId      String          @map("actor_id") @db.Uuid
  action       String
  entityType   String          @map("entity_type")
  entityId     String?         @map("entity_id") @db.Uuid
  before       Json?
  after        Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}
