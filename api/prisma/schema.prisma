// GymBro — schema Prisma (PostgreSQL).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado operativo del gym en la plataforma (RN-TEN-002 / CU-ROL-002).
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Tipo de perfil autenticado. Staff y afiliado nunca comparten sesión (RN-ROL-005).
enum AuthProfileType {
  SUPER
  STAFF
  MEMBER
}

/// Gimnasio / estudio = tenant SaaS.
///
/// @remarks Aislamiento row-level: el resto de tablas de negocio
/// referenciarán `tenants.id` como `tenant_id` (RN-TEN-001).
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  staffUsers  StaffUser[]
  members     Member[]
  branches    Branch[]
  roles       Role[]
  auditEvents AuditEvent[]

  @@map("tenants")
}

/// Sucursal / sede física del tenant (S2: modelo multi-sede, MVP 1 visible).
///
/// @remarks RN-TEN-003. Al crear un tenant se inserta una sede default (`isDefault`).
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("branches")
}

/// Super Admin de la plataforma GymBro (RN-ROL-001). Sin tenant.
model SuperUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("super_users")
}

/// Usuario staff de un tenant (puede tener N roles en E1).
model StaffUser {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  staffRoles    StaffUserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("staff_users")
}

/// Afiliado (socio) de un tenant. Perfil separado del staff (RN-ROL-005).
model Member {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("members")
}

/// Refresh token persistido (hash). Revocable en logout / rotación.
model RefreshToken {
  id          String          @id @default(uuid()) @db.Uuid
  tokenHash   String          @unique @map("token_hash")
  profileType AuthProfileType @map("profile_type")
  superUserId String?         @map("super_user_id") @db.Uuid
  staffUserId String?         @map("staff_user_id") @db.Uuid
  memberId    String?         @map("member_id") @db.Uuid
  expiresAt   DateTime        @map("expires_at")
  revokedAt   DateTime?       @map("revoked_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  superUser SuperUser? @relation(fields: [superUserId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([superUserId])
  @@index([staffUserId])
  @@index([memberId])
  @@map("refresh_tokens")
}

/// Permiso de producto (catálogo global). Los roles por tenant eligen de esta lista.
///
/// @remarks RN-ROL-003: la autorización se evalúa en el tenant del staff;
/// los códigos son fijos de producto (no se inventan por gym).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  dangerous   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Rol de staff dentro de un tenant (RN-ROL-002). Seed: Admin / Profesor.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  staffRoles      StaffUserRole[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Asignación permiso ↔ rol (N:N).
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Asignación staff ↔ rol (multi-rol, RN-ROL-004).
model StaffUserRole {
  staffUserId String @map("staff_user_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffUserId, roleId])
  @@index([roleId])
  @@map("staff_user_roles")
}

/// Evento de auditoría append-only (RN-ROL-008 / CU-ROL-007).
///
/// @remarks Sin UPDATE/DELETE de negocio. `tenant_id` nulo solo si no aplica
/// (hoy siempre se setea para acciones de gym). Actor SUPER o STAFF.
model AuditEvent {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String?         @map("tenant_id") @db.Uuid
  actorProfile AuthProfileType @map("actor_profile")
  actorId      String          @map("actor_id") @db.Uuid
  action       String
  entityType   String          @map("entity_type")
  entityId     String?         @map("entity_id") @db.Uuid
  before       Json?
  after        Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}
