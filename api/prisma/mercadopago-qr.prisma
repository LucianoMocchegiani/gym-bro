model MercadoPagoQrSetup {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  mpUserId  String   @map("mp_user_id")
  storeId   String?  @map("store_id")
  posId     String?  @map("pos_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mercadopago_qr_setups")
}

model MercadoPagoQrOrder {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.Uuid
  mpOrderId     String   @unique @map("mp_order_id")
  qrData        String   @map("qr_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("mercadopago_qr_orders")
}
