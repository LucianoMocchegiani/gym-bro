  /// Preference Checkout Pro del gym (solo MP).
  mpPreferenceId     String?       @map("mp_preference_id")
  /// Id del pago en Mercado Pago (dedup webhook, solo MP).
  mpPaymentId        String?       @map("mp_payment_id")
  /// Order API de QR dinámico de Point.
  mpOrderId          String?       @unique @map("mp_order_id")
  /// QR payload devuelto por Mercado Pago; nunca incluye credenciales.
  mpQrData           String?       @map("mp_qr_data")
  mpInitPoint        String?       @map("mp_init_point")
  mpSandboxInitPoint String?       @map("mp_sandbox_init_point")
