# Imagen de desarrollo para la API NestJS (hot-reload vía volumen).
# Node 24 = Active LTS (estable).
FROM node:24-alpine

RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm install

COPY . .

EXPOSE 3001

CMD ["npm", "run", "start:dev"]
